{
  "name": "linguadock",
  "version": "0.1.0",
  "description": "A private, bring-your-own-key AI translation desktop app",
  "author": "luopc1218",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build": "tsc --noEmit && vite build",
    "dist": "npm run build && electron-builder",
    "test": "node --test electron/*.test.cjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "wait-on": "^9.0.0"
  },
  "build": {
    "appId": "io.github.luopc1218.linguadock",
    "productName": "LinguaDock",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!electron/*.test.cjs"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "maintainer": "luopc1218 <luopc1218@outlook.com>"
    },
    "publish": {
      "provider": "github",
      "owner": "luopc1218",
      "repo": "linguadock"
    }
  }
}
